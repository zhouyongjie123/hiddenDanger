<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyj.hiddendanger.auth.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.zyj.hiddendanger.model.domain.Role">
        <id property="id" column="id"/>
        <result property="roleName" column="role_name"/>
        <result property="creatorId" column="creator_id"/>
        <result property="updaterId" column="updater_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
        <result property="roleCode" column="role_code"/>
    </resultMap>
    <resultMap id="RoleSelectionVO" type="com.zyj.hiddendanger.model.service.auth.vo.RoleSelectionVO">
        <id property="id" column="id"/>
        <result property="roleName" column="role_name"/>
    </resultMap>

    <select id="getSelectionVO" resultType="com.zyj.hiddendanger.model.service.auth.vo.RoleSelectionVO"
            resultMap="RoleSelectionVO">
        select id, role_name
        from role
        where is_deleted = 0
    </select>
    <select id="getLeaderSelectVO" resultType="com.zyj.hiddendanger.model.service.auth.vo.RoleSelectionVO">
        select id, role_name
        from role
        where is_deleted = 0
          and role_code like '%LEADER%'
    </select>

</mapper>
